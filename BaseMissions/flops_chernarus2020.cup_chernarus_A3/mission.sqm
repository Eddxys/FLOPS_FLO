						class Item0
						{
							dataType="Trigger";
							position[]={409.64139,-10.974255,61.623596};
							class Attributes
							{
								onActivation="if (isNil ""globalMarkers"") then {   " \n "    globalMarkers = [];   " \n "};   " \n "  " \n "if (isNil ""territoryControl"") then {   " \n "    territoryControl = createHashMap;   " \n "};   " \n "  " \n "private _gridSize = 350;   " \n "private _mapSize = worldSize;   " \n "private _detectionRadius = _gridSize * 1.5;   " \n "  " \n "for ""_x"" from 0 to floor(_mapSize / _gridSize) do {   " \n "    for ""_y"" from 0 to floor(_mapSize / _gridSize) do {   " \n "        private _markerName = format [""territory_%1_%2"", _x, _y];   " \n "        private _pos = [(_x * _gridSize), (_y * _gridSize)];   " \n "           " \n "        private _marker = createMarkerLocal [_markerName, _pos];   " \n "        _marker setMarkerShape ""RECTANGLE"";   " \n "        _marker setMarkerBrush ""DiagGrid"";   " \n "        _marker setMarkerSize [_gridSize/2, _gridSize/2];   " \n "        _marker setMarkerColor ""ColorGrey"";   " \n "        _marker setMarkerAlpha 0;   " \n "        globalMarkers pushBack [_marker, _pos];   " \n "        territoryControl set [_marker, ""ColorGrey""];   " \n "    };   " \n "};   " \n "  " \n "[_detectionRadius] spawn {   " \n "    params [""_detectionRadius""];   " \n "       " \n "    while {true} do {   " \n "        _units = [];   " \n "        {   " \n "            if (((vehicle _x) isKindOf ""Land"") || ((vehicle _x) isKindOf ""CAManBase"")) then {   " \n "                if !(vehicle _x isKindOf ""Air"") then {   " \n "                    if !(typeOf _x in [""B_Pilot_F"", ""O_Pilot_F"", ""I_Pilot_F""]) then {   " \n "                        _units pushBack [_x, side _x, getPosWorld _x];   " \n "                    };   " \n "                };   " \n "            };   " \n "        } forEach allUnits;   " \n "           " \n "        {   " \n "            _markerData = _x;   " \n "            _marker = _markerData select 0;   " \n "            _pos = _markerData select 1;   " \n "               " \n "            private _blufor = 0;   " \n "            private _opfor = 0;   " \n "            private _independent = 0;   " \n "            private _civilian = 0;   " \n "               " \n "            {   " \n "                if ((_x select 2) distance2D _pos < _detectionRadius) then {   " \n "                    switch (_x select 1) do {   " \n "                        case west: {_blufor = _blufor + 1};   " \n "                        case east: {_opfor = _opfor + 1};   " \n "                        case resistance: {_independent = _independent + 1};   " \n "                        case civilian: {_civilian = _civilian + 1};   " \n "                    };   " \n "                };   " \n "            } forEach _units;   " \n "               " \n "            private _currentControl = territoryControl get _marker;   " \n "               " \n "            private _color = switch (true) do {   " \n "                case (_blufor > 0 && _opfor == 0 && _independent == 0): {""ColorBlue""};   " \n "                case (_opfor > 0 && _blufor == 0 && _independent == 0): {""ColorRed""};   " \n "                case (_independent > 0 && _blufor == 0 && _opfor == 0): {""ColorGreen""};   " \n "                case (_civilian > 0 && _blufor == 0 && _opfor == 0 && _independent == 0): {""ColorCIV""};   " \n "                case (_blufor > 0 || _opfor > 0 || _independent > 0): {""ColorUNKNOWN""};   " \n "                default {_currentControl};   " \n "            };   " \n "               " \n "            if (_color != _currentControl) then {   " \n "                if (_color == ""ColorGrey"") then {   " \n "                    _marker setMarkerAlpha 0;   " \n "                } else {   " \n "                    _marker setMarkerAlpha 0.7;   " \n "                    _marker setMarkerColor _color;   " \n "                };   " \n "                territoryControl set [_marker, _color];   " \n "            };   " \n "        } forEach globalMarkers;   " \n "           " \n "        sleep 3;   " \n "    };   " \n "};";
								sizeA=0.1;
								sizeB=0.1;
								activationType="NOT PRESENT";
								activationBy="ANYPLAYER";
								isServerOnly=1;
							};
